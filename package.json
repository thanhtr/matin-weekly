{
  "name": "matin-weekly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"wrangler dev --local\"",
    "dev:worker": "wrangler dev --local",
    "build": "vite build && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply matin-weekly-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply matin-weekly-db --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.6",
    "wrangler": "^4.0.0"
  }
}
